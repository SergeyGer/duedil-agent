# === DueDil.Agent environment variables ===
# Copy this file to ".env" and fill in your keys.

# --- LLM providers ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
# Which model to use by default: "gpt-4o" or "claude-3-5-sonnet"
DUE_DIL_MODEL=gpt-4o

# --- LlamaParse (PDF -> Markdown) ---
LLAMA_CLOUD_API_KEY=llx-...

# --- Tavily (web search) ---
TAVILY_API_KEY=tvly-...

# --- LangSmith tracing (optional) ---
# The SDK reads the LANGSMITH_* names; the older LANGCHAIN_* ones still work as
# aliases. If your organization lives on the EU instance, the endpoint must be
# https://eu.api.smith.langchain.com - pointing at the US endpoint makes every
# API call fail with `403 Forbidden`, regardless of the key.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=DueDil.Agent
# Only needed for keys scoped to more than one workspace (the workspace UUID).
# LANGSMITH_WORKSPACE_ID=

LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_...
LANGCHAIN_PROJECT=DueDil.Agent

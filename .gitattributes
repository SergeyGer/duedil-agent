# Normalise line endings to LF in the repository and working tree.
* text=auto eol=lf

# Binary assets should never be touched by text normalisation.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# Windows batch wrappers keep CRLF so they look right in Notepad and run natively.
*.cmd text eol=crlf
*.ps1 text eol=crlf
